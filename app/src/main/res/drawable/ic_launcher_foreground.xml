<?xml version="1.0" encoding="utf-8"?>
<!-- LumoBrowser mark: an orbit ring around a luminous core, drawn purely as vectors. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- orbit ring -->
    <path
        android:pathData="M54,24 a30,30 0 1,1 -0.1,0 z M54,34 a20,20 0 1,0 0.1,0 z"
        android:fillType="evenOdd">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="24" android:startY="24"
                android:endX="84" android:endY="84">
                <item android:offset="0.0" android:color="#FF35E0F0" />
                <item android:offset="1.0" android:color="#FF8B7CFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- luminous core -->
    <path
        android:pathData="M54,44 a10,10 0 1,1 -0.1,0 z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="54" android:gradientRadius="14">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.45" android:color="#FF7BE9FF" />
                <item android:offset="1.0" android:color="#FF35E0F0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- orbit satellite -->
    <path
        android:pathData="M84,50 a5,5 0 1,1 -0.1,0 z"
        android:fillColor="#FFFFFFFF" />
</vector>
